                    "text": "Resend OTP",
                    "fontSize": 16,
                    "fontWeight": 600,
                    "color": "#176AD6",
                    "textAlign": "center",
                    "fillMaxWidth": true,
                    "minHeight": 28,
                    "lineHeight": 22
                  }
                }
              ]
            },
            {
              "id": "otp_verify_section",
              "type": "stack_section",
              "properties": {
