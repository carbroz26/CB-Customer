                  "binding": {
                    "key": "otp"
                  },
                  "validation": {
                    "required": true,
                    "pattern": "^[0-9]{6}$",
                    "requiredMessage": "OTP is required.",
                    "message": "Please enter the 6-digit OTP.",
                    "clearOnEdit": true
                  }
                }
              ]
            },
            {
              "id": "otp_timer_section",
