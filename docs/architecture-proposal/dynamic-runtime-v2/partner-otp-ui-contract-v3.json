                      {
                        "type": "divider",
                        "properties": {
                          "orientation": "horizontal",
                          "width": 143,
                          "thickness": 1,
                          "color": "#CBD5E1",
                          "spacing": {
                            "start": 6
                          }
                        }
                      }
                    ],
                    "lineHeight": 20
                  }
                }
              ]
            },
