                    "textColor": "#FFFFFF",
                    "background": {
                      "color": "#176AD6"
                    },
                    "shape": {
                      "type": "roundedCorner",
                      "cornerRadius": 16
                    },
                    "loading": {
                      "whileActionPending": true,
                      "disableWhilePending": true,
                      "replaceContent": true,
                      "indicator": {
                        "type": "circular",
                        "size": 20,
                        "color": "#FFFFFF"
                      }
                    },
                    "lineHeight": 26
                  },
                  "actions": {
                    "onClick": {
                      "type": "request",
                      "payload": {
                        "method": "POST",
                        "endpoint": "/api/v1/auth/verify",
                        "authentication": "NONE",
                        "validate": true,
                        "responseMode": "destination",
                        "body": {
                          "challengeId": {
                            "$state": "challengeId"
                          },
                          "phoneNumber": {
                            "$state": "phoneNumber"
                          },
                          "deviceId": {
                            "$context": "deviceId"
                          },
                          "code": {
                            "$binding": "otp"
                          }
