{
  "status": 200,
  "code": "SUCCESS",
  "message": "Partner OTP screen fetched successfully",
  "data": {
    "screenId": "partner_otp",
    "schemaVersion": "3.0.0",
    "targetApp": "PARTNER",
    "initialBindings": {
